OLLAMA_API=
TEMPLATE_SHEET_URL=

MONGODB_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:3000/api/google/callback
GOOGLE_SESSION_SECRET=
# Browser-visible key from the same Cloud project; restrict it to Google Picker API.
GOOGLE_PICKER_API_KEY=
# Numeric Cloud project number (not the project name).
GOOGLE_PROJECT_NUMBER=

# Discord Assist (optional)
# Create a Discord application/bot and enable the Message Content privileged intent.
DISCORD_BOT_TOKEN=
DISCORD_INTERNAL_SECRET=
# The existing Excela account that owns the planner receiving Discord events.
DISCORD_USER_EMAIL=
# Comma-separated channel IDs to monitor. Start with announcement channels only.
DISCORD_CHANNEL_IDS=
# Local default; use your deployed Excela URL in production.
EXCELA_API_URL=https://localhost:3000
